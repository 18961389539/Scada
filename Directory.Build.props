<Project>

  <!--
    全仓统一的构建策略。此前 17 个 csproj 各写一遍 <Nullable>/<ImplicitUsings>，
    新增项目靠复制粘贴，缺一项也没人发现；TreatWarningsAsErrors / Deterministic
    这类门禁则一处都没设，等于「0 告警」全靠自觉。

    这里只放与项目无关的公共属性；包版本在 Directory.Packages.props。
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 可空性告警升级为错误。它们几乎总是真 bug（空引用）。
         CA1305（区域设置）同样升级：它在本仓不是风格问题——周期键、备份文件名、报表数值
         都直接受 CurrentCulture 影响，非公历区域会静默产出 2569 年或 "12,5"。 -->
    <WarningsAsErrors>nullable;CA1305</WarningsAsErrors>

    <!-- 但 CA1305 只在存量已清零的两个项目里算错误：Engine/Gateway/Desktop 还有约 50 处
         （报表 locale、网关凭据、报警文案），直接全局红会让构建立刻失败。
         其余项目清理完各自目录后，把项目名从这一行删掉即可收紧。 -->
    <WarningsNotAsErrors Condition="'$(MSBuildProjectName)' != 'Scada.Core' and '$(MSBuildProjectName)' != 'Scada.Data'">CA1305</WarningsNotAsErrors>

    <!-- 可复现构建：CI 上固定源路径与确定性输出，本地保持默认以免打断调试。 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- 分析器保持 SDK 默认集合（不抬到 Recommended），避免一次性引入上百条存量告警。 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- 分析器灰度：Core 与 Data 的存量已清零，按 Recommended 规则集并且"新增即红"。
         Server/Collector 试过一次全量 Recommended：单次构建新增约 340 条 CA1305、120 条 CA1861、
         106 条 CA1051 等，量级不适合一轮清理；等这两处按目录逐个清零后再把条件放宽。
         注意这里仍是"告警"而不是"错误"：直接升成错误会让构建立刻失败。
         若某次改动让告警吵到无法工作，删掉这一行即可回到 SDK 默认集合。 -->
    <AnalysisMode Condition="'$(MSBuildProjectName)' == 'Scada.Core' or '$(MSBuildProjectName)' == 'Scada.Data'">Recommended</AnalysisMode>
  </PropertyGroup>

</Project>
