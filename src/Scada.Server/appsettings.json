{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Scada": {
    "ConfigDbPath": "data/scada.db",
    "HistoryRoot": "data/history",
    "BackupRoot": "data/backups",
    "HistoryRetentionMonths": 2,
    "Agg5MinRetentionDays": 365,
    "BackupRetentionDays": 30,
    "ArchiveFlushIntervalMs": 1000,
    "ArchiveBatchSize": 2000,
    "PushIntervalMs": 500,
    "CommandTimeoutMs": 5000,
    "ControlRequireConfirmByDefault": false,
    "ConfigRefreshSeconds": 10,
    "SeedDemoData": false,
    "AggregationEnabled": true
  },
  "Jwt": {
    "Issuer": "ScadaServer",
    "Audience": "ScadaWeb",
    "Key": "",
    "ExpireHours": 8
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  }
}
