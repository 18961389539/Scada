{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Scada": {
    "SiteName": "SCADA",
    "DemoMode": false,
    "RequirePasswordChangeOnFirstLogin": true,
    "DataRoot": "",
    "License": {
      "Enabled": true,
      "TrialDays": 365,
      "WarningDays": 15,
      "ClockSkewSeconds": 300,
      "PublicKey": ""
    },
    "ConfigDbPath": "scada.db",
    "HistoryRoot": "history",
    "BackupRoot": "backups",
    "HistoryRetentionMonths": 6,
    "Agg5MinRetentionDays": 365,
    "AggHourRetentionDays": 0,
    "HistorySizeWarnGb": 0,
    "HistoryCapacityWarnDays": 7,
    "DiskFreeWarnGb": 5,
    "HistoryQueryMaxConcurrent": 4,
    "HistoryQueryTimeoutSeconds": 30,
    "HistoryQueryMaxReadPoints": 2000000,
    "HistoryAnalysisMaxPoints": 200000,
    "BackupRetentionDays": 30,
    "AlarmEventRetentionDays": 365,
    "ArchiveFlushIntervalMs": 1000,
    "ArchiveBatchSize": 2000,
    "PushIntervalMs": 500,
    "CommandTimeoutMs": 5000,
    "CSharpScripts": {
      "Enabled": false,
      "WorkerCount": 2,
      "TimeoutMs": 3000,
      "CompileTimeoutMs": 15000,
      "MemoryLimitMb": 512,
      "WorkerPath": "",
      "DotnetPath": "dotnet",
      "SerialProfiles": {}
    },
    "ControlRequireConfirmByDefault": false,
    "ConfigRefreshSeconds": 10,
    "SeedDemoData": false,
    "AggregationEnabled": true,
    "FullBackupIntervalHours": 168,
    "BackupKeepLatest": 7,
    "BackupDrillEnabled": true,
    "BackupTargets": [],
    "MetricsToken": "",
    "HealthAnonymous": false,
    "HealthRequireSystem": false,
    "SecurityHeaders": true,
    "ApiRateLimitPerMinute": 1200,
    "AnonymousRateLimitPerMinute": 120,
    "ReadRequestTimeoutSeconds": 30,
    "WriteRequestTimeoutSeconds": 120,
    "MaxUploadMb": 200,
    "Telemetry": {
      "Enabled": true,
      "Endpoint": "",
      "ServiceName": "scada-server",
      "SamplingRatio": 0.2,
      "EntityFrameworkCore": true
    },
    "LogRetainedFiles": 30,
    "LogFileSizeLimitMb": 50,
    "WatchdogStallSeconds": 180,
    "Ai": {
      "Enabled": true,
      "RequestsPerMinute": 120,
      "MaxRangeDays": 31,
      "MaxPoints": 1000,
      "MaxAlarmRows": 200,
      "ExposeToolManifest": true
    }
  },
  "Ha": {
    "Enabled": false,
    "NodeId": "",
    "PeerUrl": "",
    "SelfUrl": "",
    "SharedKey": "",
    "WitnessPath": null,
    "AutoFailover": true,
    "PreferPrimary": false,
    "HeartbeatMs": 1000,
    "LeaseMs": 6000,
    "ClockSkewMs": 1000
  },
  "Jwt": {
    "Issuer": "ScadaServer",
    "Audience": "ScadaWeb",
    "Key": "",
    "ExpireHours": 8
  },
  "AllowedHosts": "*",
  // 默认只监听明文 HTTP：局域网内可直接嗅探到 8 小时有效期的 JWT。生产环境必须二选一：
  //   1) 把 SCADA 放在 Nginx / IIS ARR 等反向代理之后由代理终结 TLS —— 保持下面的 Http 即可；
  //   2) 让 Kestrel 直接终结 TLS —— 在 Endpoints 中增加 "Https": { "Url": "https://0.0.0.0:5443" }，
  //      并在 Kestrel:Certificates:Default 下配 Path + Password，或用环境变量
  //      ASPNETCORE_Kestrel__Certificates__Default__Path / __Password 指定 PFX。
  // 两种方式的 HTTPS 请求都会带上 HSTS 头（Middleware/SecurityHeaders.cs）；未启用时启动会记录告警。
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Mcp": {
    "Enabled": true,
    "RequestsPerMinute": 120,
    "AllowedCidrs": [],
    "AllowControlWrites": false,
    "ControlUser": "",
    "AllowConfigurationWrites": false,
    "AuditFlushTimeoutMs": 5000
  },
  "External": {
    "Rest": {
      "Enabled": true,
      "AllowJwt": true,
      "CorsOrigins": [],
      "DefaultRateLimitPerMinute": 120
    },
    "Tcp": {
      "Enabled": false,
      "ListenAddress": "0.0.0.0",
      "Port": 7500,
      "Tls": false,
      "MaxConnections": 64,
      "IpAllowlist": [],
      "IdleTimeoutSec": 120,
      "MaxFrameBytes": 262144
    },
    "OpcUa": {
      "Enabled": false,
      "EndpointUrl": "opc.tcp://0.0.0.0:4840/Scada",
      "SecurityModes": "None,Sign,SignAndEncrypt",
      "AllowAnonymous": false,
      "AllowUsernamePassword": true,
      "AllowCertificateUser": false,
      "MaxSessionCount": 50,
      "PublishingIntervalMs": 500
    }
  }
}
