{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Scada": {
    "SiteName": "SCADA",
    "DemoMode": false,
    "DataRoot": "",
    "License": {
      "Enabled": true,
      "TrialDays": 120,
      "WarningDays": 15,
      "ClockSkewSeconds": 300,
      "PublicKey": ""
    },
    "ConfigDbPath": "scada.db",
    "HistoryRoot": "history",
    "BackupRoot": "backups",
    "HistoryRetentionMonths": 2,
    "Agg5MinRetentionDays": 365,
    "AggHourRetentionDays": 0,
    "HistorySizeWarnGb": 0,
    "HistoryCapacityWarnDays": 7,
    "DiskFreeWarnGb": 5,
    "HistoryQueryMaxConcurrent": 4,
    "HistoryQueryTimeoutSeconds": 30,
    "HistoryQueryMaxReadPoints": 2000000,
    "HistoryAnalysisMaxPoints": 200000,
    "BackupRetentionDays": 30,
    "ArchiveFlushIntervalMs": 1000,
    "ArchiveBatchSize": 2000,
    "PushIntervalMs": 500,
    "CommandTimeoutMs": 5000,
    "CSharpScripts": {
      "Enabled": false,
      "WorkerCount": 2,
      "TimeoutMs": 1000,
      "CompileTimeoutMs": 15000,
      "MemoryLimitMb": 512,
      "WorkerPath": "",
      "DotnetPath": "dotnet"
    },
    "ControlRequireConfirmByDefault": false,
    "ConfigRefreshSeconds": 10,
    "SeedDemoData": false,
    "AggregationEnabled": true,
    "FullBackupIntervalHours": 168,
    "BackupKeepLatest": 7,
    "BackupDrillEnabled": true,
    "BackupTargets": [],
    "MetricsToken": "",
    "LogRetainedFiles": 30,
    "LogFileSizeLimitMb": 50,
    "WatchdogStallSeconds": 180
  },
  "Ha": {
    "Enabled": false,
    "NodeId": "",
    "PeerUrl": "",
    "SelfUrl": "",
    "SharedKey": "",
    "WitnessPath": null,
    "AutoFailover": true,
    "PreferPrimary": false,
    "HeartbeatMs": 1000,
    "LeaseMs": 6000,
    "ClockSkewMs": 1000
  },
  "Jwt": {
    "Issuer": "ScadaServer",
    "Audience": "ScadaWeb",
    "Key": "",
    "ExpireHours": 8
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Mcp": {
    "Enabled": false,
    "AllowJwt": false,
    "RequestsPerMinute": 120
  },
  "External": {
    "Rest": {
      "Enabled": true,
      "AllowJwt": true,
      "CorsOrigins": [],
      "DefaultRateLimitPerMinute": 120
    },
    "Tcp": {
      "Enabled": false,
      "ListenAddress": "0.0.0.0",
      "Port": 7500,
      "Tls": false,
      "MaxConnections": 64,
      "IpAllowlist": [],
      "IdleTimeoutSec": 120,
      "MaxFrameBytes": 262144
    },
    "OpcUa": {
      "Enabled": false,
      "EndpointUrl": "opc.tcp://0.0.0.0:4840/Scada",
      "SecurityModes": "None,Sign,SignAndEncrypt",
      "AllowAnonymous": false,
      "AllowUsernamePassword": true,
      "AllowCertificateUser": false,
      "MaxSessionCount": 50,
      "PublishingIntervalMs": 500
    }
  }
}
