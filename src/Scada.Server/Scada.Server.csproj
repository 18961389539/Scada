<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <EmbeddedResource Include="Localization\messages.en-US.json" LogicalName="Scada.Server.Localization.messages.en-US.json" WithCulture="false" />
    <!-- 授权公钥随程序集编译：不读外部文件，避免被替换公钥后自签激活码。 -->
    <EmbeddedResource Include="Licensing\license-public.pem" LogicalName="Scada.Server.Licensing.license-public.pem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scada.Core\Scada.Core.csproj" />
    <ProjectReference Include="..\Scada.Data\Scada.Data.csproj" />
    <ProjectReference Include="..\Scada.Collector\Scada.Collector.csproj" />
    <ProjectReference Include="..\Scada.Engine\Scada.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="2.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 现场双击启动不弹出控制台窗口；启动失败由 StartupErrorDialog 弹窗提示，日志仍写 data/logs。 -->
    <OutputType>WinExe</OutputType>
    <!-- exe 文件与资源管理器显示的图标；多尺寸 16/32/48/64/128/256，与托盘/PWA 同图形。 -->
    <ApplicationIcon>Scada.Server.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../web</FrontendRoot>
  </PropertyGroup>

  <Target Name="PublishFrontend" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(FrontendRoot)/package-lock.json')" Text="Frontend source and package-lock.json are required to publish the server." />
    <!-- 已有依赖时跳过 npm ci：避免每次发布重装整棵依赖（离线/弱网现场常常因此失败）。
         CI 是干净检出，node_modules 不存在，仍会执行 npm ci。 -->
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci --no-audit --no-fund" Condition="!Exists('$(FrontendRoot)/node_modules')" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
    <ItemGroup>
      <FrontendDist Include="$(FrontendRoot)/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(FrontendDist.RecursiveDir)%(FrontendDist.Filename)%(FrontendDist.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Import Project="..\Scada.ScriptWorker\Scada.ScriptWorker.targets" />
</Project>
