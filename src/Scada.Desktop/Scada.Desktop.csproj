<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\Scada.Server\Scada.Server.ico</ApplicationIcon>
    <AssemblyName>Scada.Desktop</AssemblyName>
    <RootNamespace>Scada.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <!-- 只使用 WinForms 控件；WPF 程序集会带入不同版本的 WindowsBase，造成无意义的引用冲突告警。 -->
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- 单元测试需要覆盖配置校验、URL 构建、注入脚本与登录结果分类。 -->
    <InternalsVisibleTo Include="Scada.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘需要多尺寸图标，复用服务端图标避免 16px 下发虚。 -->
    <EmbeddedResource Include="..\Scada.Server\Scada.Server.ico" LogicalName="Scada.Desktop.app.ico" />
  </ItemGroup>

</Project>
