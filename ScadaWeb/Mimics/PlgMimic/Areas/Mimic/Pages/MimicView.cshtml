@page "{id:int?}"
@model MimicViewModel
@inject IWebContext webContext
@inject PluginContext pluginContext
@{
    Layout = "_BasicLayout";
    dynamic dict = Locale.GetDictionary(Model.GetType().FullName);
    var toolbarClass = pluginContext.PluginConfig.RuntimeOptions.ShowToolbar ? "" : "toolbar-hidden";
}

@section Styles {
    <link href="~/plugins/Mimic/css/mimic.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plugins/Mimic/css/mimic-view.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plugins/Mimic/css/usability.css" rel="stylesheet" asp-append-version="true" />
    @pluginContext.PageReferences.RenderStyles(Url)
    <style>
        /* Dark scheme: the whole canvas is inverted as one unit, so inline SVG colours stay consistent. */
        body.mimic-dark { background: #0f1620; }
        #divMimicWrapper.mimic-dark { background: #0f1620; }
        #divMimicWrapper.mimic-dark .mimic { filter: invert(1) hue-rotate(180deg); }
        #divMimicWrapper.mimic-dark .mimic img { filter: invert(1) hue-rotate(180deg); }
        @@media (pointer: coarse) {
            #divToolbar .tool-btn, #divToolbar .tool-item { height: 44px; line-height: 44px; padding: 0 16px; }
        }
    </style>
}

@section Scripts {
    <script src="~/js/view-hub.js" asp-append-version="true"></script>
    <script src="~/js/components/modal.js" asp-append-version="true"></script>
    <script src="~/plugins/Main/js/main-api.js" asp-append-version="true"></script>
    <script src="~/plugins/Mimic/js/mimic-bundle.js" asp-append-version="true"></script>
    <script src="~/plugins/Mimic/js/mimic-view.js" asp-append-version="true"></script>
    <script>
        viewID = @Model.ViewID;
        controlRight = @Model.ControlRight.ToLowerString();
        mimicIsAdmin = @Model.IsAdmin.ToLowerString();
        refreshRate = @webContext.AppConfig.DisplayOptions.RefreshRate;
        fonts = @pluginContext.PluginConfig.Fonts.ToJs();
        runtimeOptions = @pluginContext.PluginConfig.RuntimeOptions.ToJs();
        phrases = @WebUtils.DictionaryToJs(Model.GetType().FullName + ".Js");
    </script>
    @pluginContext.PageReferences.RenderScripts(Url)
}

<div id="divError" class="box-center fs-2 text-danger d-none"></div>
<nav id="runtimeNavigation" aria-label="@(Locale.Culture.Name.StartsWith("zh") ? "运行画面导航" : "Runtime navigation")">
    @foreach (var view in Model.NavigationViews)
    {
        <a href="@Url.Content("~/View/" + view.ViewID)" target="_top" class="@(view.ViewID == Model.ViewID ? "current" : "")" aria-current="@(view.ViewID == Model.ViewID ? "page" : null)">@view.Title</a>
    }
</nav>
@Html.AntiForgeryToken()
<div id="divSpinner" class="box-center fs-2 text-secondary d-none"><i id="iSpinner" class="fa-solid fa-spinner fa-spin-pulse fa-3x"></i></div>
<div id="divMimicWrapper" class="mimic-wrapper view-mode"></div>
<div id="divToolbar" class="@toolbarClass d-none"><button type="button" 
    id="btnFitScreen" class="tool-item tool-btn" title="@dict.btnFitScreen_ToolTip"><i class="fa-solid fa-up-down-left-right"></i> @dict.btnFitScreen_ToolTip</button><button type="button"
    id="btnFitWidthBtn" class="tool-item tool-btn" title="@dict.btnFitWidth_ToolTip"><i class="fa-solid fa-solid fa-left-right"></i></button><button type="button"
    id="btnZoomOutBtn" class="tool-item tool-btn" title="@dict.btnZoomOut_ToolTip"><i class="fa-solid fa-search-minus"></i></button><button type="button"
    id="btnZoomInBtn" class="tool-item tool-btn" title="@dict.btnZoomIn_ToolTip"><i class="fa-solid fa-search-plus"></i></button><span
    id="spanScaleValue" class="tool-item">%</span><span 
    id="spanErrorIcon" class="d-none" title="@dict.spanErrorIcon_ToolTip"><i class="fa-solid fa-triangle-exclamation"></i></span><button type="button"
    id="btnHelp" class="tool-item tool-btn" title="@dict.btnHelp_ToolTip"><i class="fa-solid fa-circle-question"></i></button><button type="button"
    id="btnTheme" class="tool-item tool-btn" title="@dict.btnTheme_ToolTip" aria-pressed="false"><i class="fa-solid fa-moon"></i></button><button type="button"
    id="btnFullscreen" class="tool-item tool-btn" title="@dict.btnFullscreen_ToolTip" aria-pressed="false"><i class="fa-solid fa-expand"></i></button><button type="button"
    id="btnRotate" class="tool-item tool-btn" title="@dict.btnRotate_ToolTip" aria-pressed="false"><i class="fa-solid fa-arrows-rotate"></i></button>@if (Model.CanEditMimic) {<a 
    id="btnEditMimic" class="tool-item tool-btn" href="@Url.Content(Model.EditMimicUrl)" onclick="event.preventDefault(); var w = window.open(this.href, '_blank'); if (w) { w.opener = null; } else { window.location.href = this.href; } return false;" title="@dict.btnEditMimic_ToolTip"><i class="fa-solid fa-pen-to-square"></i></a>}
</div>
