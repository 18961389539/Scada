@page "{key}"
@model MimicEditModel
@inject EditorManager editorManager
@{
    Layout = "_BasicLayout";
    dynamic dict = Locale.GetDictionary(Model.GetType().FullName);
}

@if (Model.HasError)
{
    <div class="box-center fs-2 text-danger">
        @Model.ErrorMessage
    </div>
    return;
}

@section Styles {
    <link href="~/plugins/Mimic/css/mimic.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plugins/MimicEditor/css/mimic-edit.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plugins/MimicEditor/css/usability.css" rel="stylesheet" asp-append-version="true" />
    @editorManager.PageReferences.RenderStyles(Url)
}

@section Scripts {
    <script type="importmap">
        {
            "imports": {
              "lib/": "./../../../plugins/MimicEditor/lib/"
            }
        }
    </script>
    <script type="module">
        import { Pane as Tweakpane } from "lib/tweakpane/tweakpane-4.0.5.min.js";
        import * as TweakpaneEssentialsPlugin from "lib/tweakpane/tweakpane-plugin-essentials-0.2.1.min.js";
        window.Tweakpane = Tweakpane;
        window.TweakpaneEssentialsPlugin = TweakpaneEssentialsPlugin;
    </script>
    <script src="~/js/components/splitter.js" asp-append-version="true"></script>
    <script src="~/plugins/Mimic/js/mimic-bundle.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/lib/codeflask/codeflask.min.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/editor-bundle.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/mimic-edit.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/usability.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/prop-search.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/structure-search.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/editor-help.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/autosave.js" asp-append-version="true"></script>
    <script src="~/plugins/MimicEditor/js/mimic-edit-lang.js"></script>
    <script>
        rootPath = "@Url.Content("~/")";
        mimicKey = "@Model.MimicKey";
        fonts = @editorManager.PluginConfig.Fonts.ToJs();
        editorOptions = @editorManager.PluginConfig.EditorOptions.ToJs();
    </script>
    @editorManager.PageReferences.RenderScripts(Url)
}

<style>
    .props-hint { padding: 18px 14px; color: #66788d; font-size: 12px; line-height: 1.8; }
    /* Auto-save banner: the draft is only offered, never applied silently. */
    .autosave-banner {
        align-items: center; background: #fff4e5; border-bottom: 1px solid #f0c48a; color: #7a4a00;
        display: flex; gap: 12px; justify-content: space-between; padding: 8px 14px;
    }
    .autosave-banner .btn { white-space: nowrap; }
    /* Property search bar. Sticky so it stays reachable while the grid scrolls. */
    .prop-tools {
        align-items: center; background: var(--bs-gray-100); border-bottom: 1px solid var(--bs-gray-300);
        display: flex; flex-wrap: wrap; gap: 6px; padding: 6px 8px; position: sticky; top: 0; z-index: 3;
    }
    .prop-tools[hidden] { display: none; }
    .prop-tools #txtPropSearch { flex: 1 1 110px; font-size: 12px; min-width: 0; }
    .prop-tools label { align-items: center; display: inline-flex; font-size: 11px; gap: 4px; margin: 0; white-space: nowrap; }
    .prop-tools .prop-count { color: var(--bs-secondary); font-size: 11px; margin-left: auto; }
    /* Union edit: state clearly that one change hits every selected component. */
    .prop-multi-hint {
        background: #eaf2fc; border-bottom: 1px solid #c7dcf5; color: #1b4f8a;
        font-size: 12px; line-height: 1.5; padding: 6px 10px;
    }
    .prop-multi-hint[hidden] { display: none; }
    /* While searching, expand every folder so matches are actually visible. */
    #tweakpane.rs-prop-searching .tp-fldv_c {
        height: auto !important; opacity: 1 !important; overflow: visible !important;
        padding-bottom: var(--cnt-vp) !important; padding-top: var(--cnt-vp) !important;
    }
    #tweakpane.rs-prop-searching .tp-fldv-cpl:not(.tp-fldv-expanded) > .tp-fldv_c { display: block !important; }
</style>
<div id="divToolbar"><partial name="_ToolbarContents" /></div>
@if (Model.HasAutoSave)
{
    <div id="divAutoSaveBanner" class="autosave-banner">
        <span><i class="fa-solid fa-clock-rotate-left"></i> @string.Format(dict.autoSaveBanner, Model.AutoSaveTime)</span>
        <form method="post" class="d-flex gap-2 m-0">
            <button type="submit" class="btn btn-sm btn-warning" asp-page-handler="RestoreAutoSave">@dict.btnRestoreAutoSave</button>
            <button type="submit" class="btn btn-sm btn-outline-secondary" asp-page-handler="DiscardAutoSave">@dict.btnDiscardAutoSave</button>
        </form>
    </div>
}
<style>
    @@media (pointer: coarse) {
        #divToolbar .btn-sm { min-height: 42px; min-width: 42px; }
        .component-item { min-height: 40px; }
    }
</style>
<div id="divMain" spellcheck="false">
    <div id="divLeftPanel">
        <ul class="nav nav-tabs nav-fill flex-nowrap">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#divComponents" title="@dict.btnComponents"><i class="fa-solid fa-cubes"></i></button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#divStructure" title="@dict.btnStructure"><i class="fa-solid fa-folder-tree"></i></button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#divProperties" title="@dict.btnProperties"><i class="fa-solid fa-table-list"></i></button>
            </li>
        </ul>
        <div class="tab-content">
            <div id="divComponents" class="tab-pane show active"><partial name="_ComponentList" model="@editorManager.ModelMeta" /></div>
            <div id="divStructure" class="tab-pane">
                @{
                    bool structureSearchZh = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("zh");
                    string StructureText(string cn, string en) => structureSearchZh ? cn : en;
                }
                <div class="structure-search-tools">
                    <div class="structure-search-field">
                        <input id="structureSearch" type="search" class="form-control form-control-sm"
                               placeholder="@StructureText("搜索名称、ID 或类型", "Search name, ID or type")"
                               aria-label="@StructureText("搜索画面组件", "Search mimic components")"
                               aria-describedby="structureSearchCount" />
                        <button id="structureSearchClear" type="button" class="btn btn-outline-secondary btn-sm" hidden
                                title="@StructureText("清空搜索（Esc）", "Clear search (Esc)")"
                                aria-label="@StructureText("清空搜索", "Clear search")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    </div>
                    <div id="structureSearchCount" class="structure-search-count" role="status" aria-live="polite"
                         data-total="@StructureText("共 {0} 个组件", "{0} components")"
                         data-filtered="@StructureText("匹配 {0} / {1} 个组件", "{0} / {1} components match")"></div>
                </div>
                <div id="structureSearchEmpty" class="structure-search-empty" hidden
                     data-no-matches="@StructureText("没有匹配的组件，请尝试名称、ID 或类型。", "No matching components. Try a name, ID or type.")"
                     data-no-components="@StructureText("画面中还没有组件，请从组件面板选择后放置。", "No components yet. Select one from the component panel and place it on the canvas.")"></div>
            </div>
            <div id="divProperties" class="tab-pane">
                <div id="divMultiHint" class="prop-multi-hint" hidden data-template="@dict.multiSelectHint"></div>
                <div id="divPropTools" class="prop-tools" hidden>
                    <input type="search" id="txtPropSearch" class="form-control form-control-sm"
                           placeholder="@dict.propSearchPlaceholder" aria-label="@dict.propSearchPlaceholder" />
                    <label title="@dict.propModifiedOnlyHint">
                        <input type="checkbox" id="chkPropModified" /> @dict.propModifiedOnly
                    </label>
                    <span id="spanPropCount" class="prop-count" aria-live="polite"></span>
                </div>
                <div id="divPropsHint" class="props-hint">@dict.propsEmptyHint</div>
                <div id="tweakpane"></div>
            </div>
        </div>
    </div>
    <div id="divSplitter" class="splitter vert"></div>
    <div id="divMimicWrapper" class="mimic-wrapper edit-mode"></div>
</div>
<partial name="_Usability" />
<div id="divToastContainer" class="toast-container"></div>

<partial name="_ColorModal" />
<partial name="_FaceplateModal" />
<partial name="_FontModal" />
<partial name="_ImageEditModal" />
<partial name="_ImageSelectModal" />
<partial name="_PropertyModal" />
<partial name="_TextEditor" />

<script>
    // Editor zoom. The mimic element is scaled with CSS zoom; getMimicPoint is patched so that
    // pointer coordinates stay in mimic units, otherwise selection and dragging drift.
    (function () {
        const label = document.getElementById('spanEditorZoom');
        if (!label)
            return;

        const storageKey = 'rs.mimicEditor.zoom';
        const minZoom = 0.25, maxZoom = 3, step = 0.1;
        let current = parseFloat(localStorage.getItem(storageKey)) || 1;

        function canvas() {
            try {
                return mimicElem && mimicElem.length ? mimicElem : null;
            } catch (e) {
                return null;
            }
        }

        function apply(value, store) {
            const elem = canvas();
            if (!elem)
                return false;

            current = Math.min(maxZoom, Math.max(minZoom, Math.round(value * 100) / 100));
            elem.css('zoom', current);
            label.textContent = Math.round(current * 100) + '%';
            if (store !== false)
                localStorage.setItem(storageKey, current);
            return true;
        }

        function fitWidth() {
            const elem = canvas();
            if (!elem)
                return;

            const width = parseFloat(elem[0].style.width) || elem[0].offsetWidth || 1400;
            const available = document.getElementById('divMimicWrapper').clientWidth - 24;
            apply(available / width);
        }

        // The editor converts pointer positions with getMimicPoint; divide by the zoom factor.
        const baseGetMimicPoint = window.getMimicPoint;
        if (typeof baseGetMimicPoint === 'function') {
            window.getMimicPoint = function (event, elem, opt_alignToGrid) {
                if (current === 1 || !elem)
                    return baseGetMimicPoint(event, elem, opt_alignToGrid);

                const offset = elem.offset();
                let x = Number.parseInt((event.pageX - offset.left) / current);
                let y = Number.parseInt((event.pageY - offset.top) / current);
                const gridStep = typeof getGridStep === 'function' ? getGridStep() : 0;

                if (opt_alignToGrid && gridStep > 1) {
                    x = alignValue(x, gridStep);
                    y = alignValue(y, gridStep);
                }

                return { x: x, y: y };
            };
        }

        document.getElementById('btnEditorZoomIn').addEventListener('click', () => apply(current + step));
        document.getElementById('btnEditorZoomOut').addEventListener('click', () => apply(current - step));
        document.getElementById('btnEditorZoomReset').addEventListener('click', () => apply(1));
        document.getElementById('btnEditorZoomFit').addEventListener('click', fitWidth);

        let attempts = 0;
        const timer = setInterval(function () {
            if (apply(current, false)) {
                clearInterval(timer);
            } else if (++attempts > 100) {
                clearInterval(timer);
            }
        }, 100);
    })();
</script>

<script>
    // Alignment guides: snap the dragged component to other components' edges and centers.
    // The toolbar magnet button turns the whole feature off and restores the old behaviour.
    (function () {
        const toggle = document.getElementById('btnEditorGuides');
        if (!toggle)
            return;

        const storageKey = 'rs.mimicEditor.guides';
        const threshold = 6;
        let enabled = localStorage.getItem(storageKey) !== 'false';
        let overlay = null;

        toggle.classList.toggle('active', enabled);

        function canvas() {
            try {
                return mimicElem && mimicElem.length ? mimicElem[0] : null;
            } catch (e) {
                return null;
            }
        }

        function ensureOverlay() {
            const host = canvas();
            if (!host)
                return null;

            if (!overlay || overlay.parentElement !== host) {
                overlay = document.createElement('div');
                overlay.style.cssText = 'position:absolute;left:0;top:0;right:0;bottom:0;' +
                    'pointer-events:none;z-index:60;overflow:hidden;';
                host.appendChild(overlay);
            }

            return overlay;
        }

        function clearGuides() {
            if (overlay)
                overlay.innerHTML = '';
        }

        function drawGuides(snapResult) {
            const layer = ensureOverlay();
            if (!layer)
                return;

            layer.innerHTML = '';

            if (snapResult.gx !== null) {
                const line = document.createElement('div');
                line.style.cssText = 'position:absolute;top:0;bottom:0;width:1px;background:#e0483c;' +
                    'left:' + snapResult.gx + 'px;';
                layer.appendChild(line);
            }

            if (snapResult.gy !== null) {
                const line = document.createElement('div');
                line.style.cssText = 'position:absolute;left:0;right:0;height:1px;background:#e0483c;' +
                    'top:' + snapResult.gy + 'px;';
                layer.appendChild(line);
            }
        }

        // The selection moves as one box, so snapping uses its bounds rather than a single component.
        function selectionBounds() {
            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;

            for (const component of selectedComponents) {
                const x = component.x || 0, y = component.y || 0;
                const width = component.width || 0, height = component.height || 0;
                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + width);
                maxY = Math.max(maxY, y + height);
            }

            return isFinite(minX)
                ? { x: minX, y: minY, width: maxX - minX, height: maxY - minY }
                : null;
        }

        function snapToNeighbours(box, targetX, targetY) {
            const selected = new Set(selectedComponents);
            const others = [];
            try {
                for (const component of mimic.componentMap.values()) {
                    if (!selected.has(component))
                        others.push(component);
                }
            } catch (e) {
                return { dx: 0, dy: 0, gx: null, gy: null };
            }

            const targetsX = [], targetsY = [];
            for (const other of others) {
                const width = other.width || 0, height = other.height || 0;
                targetsX.push(other.x, other.x + width / 2, other.x + width);
                targetsY.push(other.y, other.y + height / 2, other.y + height);
            }

            const width = box.width || 0, height = box.height || 0;
            let bestX = null, bestY = null;

            for (const edge of [targetX, targetX + width / 2, targetX + width]) {
                for (const target of targetsX) {
                    const delta = target - edge;
                    if (Math.abs(delta) <= threshold && (!bestX || Math.abs(delta) < Math.abs(bestX.delta)))
                        bestX = { delta: delta, at: target };
                }
            }

            for (const edge of [targetY, targetY + height / 2, targetY + height]) {
                for (const target of targetsY) {
                    const delta = target - edge;
                    if (Math.abs(delta) <= threshold && (!bestY || Math.abs(delta) < Math.abs(bestY.delta)))
                        bestY = { delta: delta, at: target };
                }
            }

            return {
                dx: bestX ? bestX.delta : 0,
                dy: bestY ? bestY.delta : 0,
                gx: bestX ? bestX.at : null,
                gy: bestY ? bestY.at : null
            };
        }

        const baseContinueDragging = window.continueDragging;
        if (typeof baseContinueDragging === 'function') {
            window.continueDragging = function (point) {
                if (!enabled || !longAction || longAction.dragType !== DragType.MOVE || selectedComponents.length === 0) {
                    clearGuides();
                    return baseContinueDragging(point);
                }

                let offsetX = point.x - longAction.startPoint.x;
                let offsetY = point.y - longAction.startPoint.y;
                const gridStep = getGridStep();

                if (gridStep > 1) {
                    offsetX = alignValue(offsetX, gridStep);
                    offsetY = alignValue(offsetY, gridStep);
                }

                const box = selectionBounds();
                if (!box) {
                    clearGuides();
                    return baseContinueDragging(point);
                }

                const result = snapToNeighbours(box, box.x + offsetX, box.y + offsetY);
                offsetX += result.dx;
                offsetY += result.dy;

                if (longAction.moved || Math.abs(offsetX) >= MIN_MOVE || Math.abs(offsetY) >= MIN_MOVE) {
                    longAction.moved = true;

                    for (const component of selectedComponents) {
                        component.renderer?.setLocation(component, component.x + offsetX, component.y + offsetY);
                    }
                }

                drawGuides(result);
            };
        }

        const baseFinishDragging = window.finishDragging;
        if (typeof baseFinishDragging === 'function') {
            window.finishDragging = function () {
                clearGuides();
                return baseFinishDragging.apply(this, arguments);
            };
        }

        toggle.addEventListener('click', function () {
            enabled = !enabled;
            toggle.classList.toggle('active', enabled);
            localStorage.setItem(storageKey, enabled);
            clearGuides();
        });
    })();
</script>

<script>
    // Empty-state hint for the property panel; hide it as soon as any row exists.
    (function () {
        const pane = document.getElementById('tweakpane');
        const hint = document.getElementById('divPropsHint');
        if (!pane || !hint)
            return;

        function update() {
            hint.style.display = pane.querySelector('.tp-rotv, .tp-fldv, .tp-tabv') ? 'none' : '';
        }

        new MutationObserver(update).observe(pane, { childList: true, subtree: true });
        update();
    })();
</script>
