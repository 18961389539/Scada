@page
@model MimicListModel
@{
    Layout = "_MainLayout";
    dynamic dict = Locale.GetDictionary(Model.GetType().FullName);
    ViewBag.Title = dict.PageTitle;
}

<h1>@dict.PageTitle</h1>

@if (Model.HasError)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div>@Model.ErrorMessage</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.RestoreMessage))
{
    <div class="alert @(Model.RestoreFailed ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div>@Model.RestoreMessage</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.CreateMessage))
{
    <div class="alert @(Model.CreateFailed ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div>@Model.CreateMessage</div>
    </div>
}

<form method="post" class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@dict.CreateMimicHeader</h5>
        <div class="input-group">
            <input class="form-control" asp-for="NewFileName" placeholder="@dict.CreateMimicPlaceholder" />
            <button class="btn btn-primary" asp-page-handler="Create">@dict.btnCreate</button>
        </div>
        <div class="form-text">@dict.CreateMimicHint</div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center gap-2 mb-2">
    <h2 class="mb-0">@dict.AvailableFilesHeader</h2>
    <input type="search" id="txtFileSearch" class="form-control form-control-sm" style="max-width: 280px;"
           placeholder="@dict.SearchFilesPlaceholder" aria-label="@dict.SearchFilesPlaceholder" />
</div>

@if (Model.AvailableFiles.Count == 0)
{
    <div class="alert alert-secondary">@dict.NoAvailableFiles</div>
}
else
{
    <div class="card mb-3">
        <ul class="list-group list-group-flush" id="ulAvailableFiles">
            @for (int i = 0; i < Model.AvailableFiles.Count; i++)
            {
                var file = Model.AvailableFiles[i];
                string formID = $"frmFile{i}";
                <li class="list-group-item d-flex justify-content-between align-items-center"
                    data-search="@($"{file.RelativePath} {file.ViewTitle}".ToLowerInvariant())">
                    <div class="d-flex align-items-center gap-2">
                        <form method="post" class="m-0" id="@formID">
                            <input type="hidden" name="FileName" value="@file.RelativePath" />
                            <input type="hidden" name="NewFileName" value="" />
                            <button type="submit" class="btn btn-link p-0 text-break" asp-page-handler="Open">@file.RelativePath</button>
                        </form>
                        @if (file.ViewID > 0)
                        {
                            <span class="badge bg-light text-secondary">@string.Format(dict.BoundViewBadge, file.ViewID, file.ViewTitle)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark" title="@dict.UnboundViewHint">@dict.UnboundViewBadge</span>
                        }
                        @if (file.Issues.Count > 0)
                        {
                            <span class="badge @(file.HasErrors ? "bg-danger" : "bg-warning text-dark")"
                                  title="@string.Join("\n", file.Issues.Select(issue => (issue.IsError ? "● " : "○ ") + issue.Message))"
                                  aria-label="@string.Format("{0} 个配置问题", file.Issues.Count)">
                                <i class="fa-solid fa-triangle-exclamation"></i> @file.Issues.Count
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">
                            @(Math.Max(1, file.Size / 1024)) KB · @file.Modified.ToString("MM-dd HH:mm")
                        </span>
                        <div class="dropdown">
                            <button type="button" class="btn btn-light btn-sm px-2" data-bs-toggle="dropdown" aria-expanded="false"
                                    aria-label="@dict.FileActions">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="submit" class="dropdown-item" form="@formID" asp-page-handler="Rename"
                                            onclick="var n = prompt('@dict.RenamePrompt', ''); if (!n) return false; this.form.elements['NewFileName'].value = n;">
                                        @dict.btnRename
                                    </button>
                                </li>
                                <li>
                                    <button type="submit" class="dropdown-item text-danger" form="@formID" asp-page-handler="Delete"
                                            onclick="return confirm('@dict.ConfirmDelete');">
                                        @dict.btnDelete
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
    <div id="divNoFileMatch" class="alert alert-secondary" hidden>@dict.NoFileMatch</div>
}

<style>
    #ulAvailableFiles > li[hidden] { display: none !important; }
</style>
<script>
    (function () {
        var input = document.getElementById('txtFileSearch');
        var list = document.getElementById('ulAvailableFiles');
        var empty = document.getElementById('divNoFileMatch');
        if (!input || !list) return;

        input.addEventListener('input', function () {
            var query = input.value.trim().toLowerCase();
            var visible = 0;

            Array.prototype.forEach.call(list.children, function (item) {
                var match = !query || (item.getAttribute('data-search') || '').indexOf(query) >= 0;
                item.hidden = !match;
                if (match) visible++;
            });

            if (empty) empty.hidden = visible > 0;
        });
    })();
</script>

<details class="mb-3">
    <summary class="text-muted">@dict.ManualOpenHeader</summary>
    <form method="post" class="mt-2">
        <div class="input-group">
            <input type="text" id="txtFileName" class="form-control" placeholder="@dict.txtFileName_Placeholder" required asp-for="FileName">
            <button type="submit" id="btnOpen" class="btn btn-primary" asp-page-handler="Open">@dict.btnOpen</button>
        </div>
    </form>
</details>

@if (Model.MimicGroups.Length > 0)
{
    <h2>@dict.ActiveMimicsHeader</h2>

    foreach (var mimicGroup in Model.MimicGroups)
    {
        <div class="card mb-3">
            <h5 class="card-header">@mimicGroup.Name</h5>
            <ul class="list-group list-group-flush">
                @foreach (var mimic in mimicGroup.GetMimics())
                {
                    var backup = Model.GetBackupInfo(mimic.FileName);
                    <form method="post">
                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <input type="hidden" name="mimicKey" value="@mimic.MimicKey" />
                            <input type="hidden" name="NewFileName" value="" />
                            <a class="text-break py-2" asp-page="/MimicEdit" asp-route-key="@mimic.MimicKey" target="_blank">@mimic.FileName</a>
                            <div class="d-flex align-items-center gap-2">
                                @if (backup.Count > 0)
                                {
                                    <span class="badge bg-light text-secondary" title="@dict.BackupHint">
                                        @string.Format(dict.BackupInfo, backup.Count, backup.Latest.ToString("MM-dd HH:mm"))
                                    </span>
                                }
                                <div class="dropdown">
                                    <button type="button" class="btn btn-light px-3" data-bs-toggle="dropdown">
                                        <i class="fa-solid fa-ellipsis-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="Save">@dict.btnSave</button></li>
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="SaveAs"
                                                    onclick="var n = prompt('@dict.SaveAsPrompt', ''); if (!n) return false; this.form.elements['NewFileName'].value = n;">@dict.btnSaveAs</button></li>
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="SaveAndClose">@dict.btnSaveAndClose</button></li>
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="CloseWithoutSaving">@dict.btnCloseWithoutSaving</button></li>
                                        @if (backup.Count > 0)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button type="submit" class="dropdown-item text-danger" asp-page-handler="Restore" onclick="return confirm('@dict.ConfirmRestore');">@dict.btnRestoreBackup</button></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </li>
                    </form>
                }
            </ul>
        </div>
    }
}
