@page
@model MimicListModel
@{
    Layout = "_MainLayout";
    dynamic dict = Locale.GetDictionary(Model.GetType().FullName);
    ViewBag.Title = dict.PageTitle;
}

@section Styles {
    <link href="~/plugins/MimicEditor/css/file-library.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="~/plugins/MimicEditor/js/file-library.js" asp-append-version="true"></script>
}

<h1>@dict.PageTitle</h1>

@if (Model.HasError)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div>@Model.ErrorMessage</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.RestoreMessage))
{
    <div class="alert @(Model.RestoreFailed ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div>@Model.RestoreMessage</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.CreateMessage))
{
    <div class="alert @(Model.CreateFailed ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <div>@Model.CreateMessage</div>
    </div>
}

<form method="post" class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@dict.CreateMimicHeader</h5>
        <div class="input-group">
            <input class="form-control" asp-for="NewFileName" placeholder="@dict.CreateMimicPlaceholder" />
            <button class="btn btn-primary" asp-page-handler="Create">@dict.btnCreate</button>
        </div>
        <div class="form-text">@dict.CreateMimicHint</div>
    </div>
</form>

<h2>@dict.AvailableFilesHeader</h2>
<form method="get" id="frmFileSearch" class="file-library-search" asp-page="MimicList"
      data-loading="@dict.SearchingFiles" data-failed="@dict.SearchFilesFailed">
    <input type="search" id="txtFileSearch" asp-for="FileQuery" class="form-control form-control-sm"
           placeholder="@dict.SearchFilesPlaceholder" aria-label="@dict.SearchFilesPlaceholder" aria-describedby="fileSearchHint" />
    <select id="selFileSort" asp-for="FileSort" class="form-select form-select-sm" aria-label="@dict.FileSortLabel">
        <option value="modified">@dict.SortModified</option>
        <option value="name">@dict.SortName</option>
    </select>
    <input type="hidden" name="FilePage" value="1" />
    <button type="submit" class="btn btn-primary btn-sm">@dict.btnFileSearch</button>
</form>
<div id="fileSearchHint" class="form-text">@dict.FileSearchHint</div>
<div id="fileLibraryStatus" class="small text-muted" role="status" aria-live="polite"></div>
<partial name="_MimicFiles" model="Model" />

<details class="mb-3">
    <summary class="text-muted">@dict.ManualOpenHeader</summary>
    <form method="post" class="mt-2">
        <div class="input-group">
            <input type="text" id="txtFileName" class="form-control" placeholder="@dict.txtFileName_Placeholder" required asp-for="FileName">
            <button type="submit" id="btnOpen" class="btn btn-primary" asp-page-handler="Open">@dict.btnOpen</button>
        </div>
    </form>
</details>

@if (Model.MimicGroups.Length > 0)
{
    <h2>@dict.ActiveMimicsHeader</h2>

    foreach (var mimicGroup in Model.MimicGroups)
    {
        <div class="card mb-3">
            <h5 class="card-header">@mimicGroup.Name</h5>
            <ul class="list-group list-group-flush">
                @foreach (var mimic in mimicGroup.GetMimics())
                {
                    var backup = Model.GetBackupInfo(mimic.FileName);
                    <form method="post">
                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <input type="hidden" name="mimicKey" value="@mimic.MimicKey" />
                            <input type="hidden" name="NewFileName" value="" />
                            <a class="text-break py-2" asp-page="/MimicEdit" asp-route-key="@mimic.MimicKey" target="_blank">@mimic.FileName</a>
                            <div class="d-flex align-items-center gap-2">
                                @if (backup.Count > 0)
                                {
                                    <span class="badge bg-light text-secondary" title="@dict.BackupHint">
                                        @string.Format(dict.BackupInfo, backup.Count, backup.Latest.ToString("MM-dd HH:mm"))
                                    </span>
                                }
                                <div class="dropdown">
                                    <button type="button" class="btn btn-light px-3" data-bs-toggle="dropdown">
                                        <i class="fa-solid fa-ellipsis-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="Save">@dict.btnSave</button></li>
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="SaveAs"
                                                    onclick="var n = prompt('@dict.SaveAsPrompt', ''); if (!n) return false; this.form.elements['NewFileName'].value = n;">@dict.btnSaveAs</button></li>
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="SaveAndClose">@dict.btnSaveAndClose</button></li>
                                        <li><button type="submit" class="dropdown-item" asp-page-handler="CloseWithoutSaving">@dict.btnCloseWithoutSaving</button></li>
                                        @if (backup.Count > 0)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button type="submit" class="dropdown-item text-danger" asp-page-handler="Restore" onclick="return confirm('@dict.ConfirmRestore');">@dict.btnRestoreBackup</button></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </li>
                    </form>
                }
            </ul>
        </div>
    }
}
