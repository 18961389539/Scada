@model Scada.Web.Plugins.PlgMimicEditor.Code.ModelMeta
@{
    dynamic searchDict = Locale.GetDictionary("Scada.Web.Plugins.PlgMimicEditor.Areas.MimicEditor.Pages.MimicEditModel.ToolbarContents");
}

<div class="component-search">
    <input type="search" id="txtComponentSearch" class="form-control form-control-sm"
           placeholder="@searchDict.txtComponentSearch_Placeholder" aria-label="搜索组件" />
    <span id="spanComponentSearchInfo" class="text-muted small"></span>
</div>

@foreach (var group in Model.ComponentGroups)
{
    <div class="component-group">
        <div class="component-group-header">@group.Name</div>
        @foreach (var item in group.Items)
        {
            <div class="component-item" data-type-name="@item.TypeName"><img 
                class="component-icon" src="@Url.Content(item.IconUrl)" /><span 
                class="component-name">@item.DisplayName</span></div>
        }
    </div>
}

<script>
    // Palette filter: 57 components are hard to scan by scrolling.
    (function () {
        const input = document.getElementById('txtComponentSearch');
        if (!input)
            return;

        const groups = Array.from(document.querySelectorAll('#divComponents .component-group'));
        const info = document.getElementById('spanComponentSearchInfo');
        const total = groups.reduce((sum, group) => sum + group.querySelectorAll('.component-item').length, 0);

        function filter() {
            const query = input.value.trim().toLowerCase();
            let shown = 0;

            groups.forEach(function (group) {
                let visible = 0;
                group.querySelectorAll('.component-item').forEach(function (item) {
                    const text = (item.textContent + ' ' + (item.dataset.typeName || '')).toLowerCase();
                    const hit = !query || text.indexOf(query) >= 0;
                    item.style.display = hit ? '' : 'none';
                    if (hit)
                        visible++;
                });
                group.style.display = visible > 0 ? '' : 'none';
                shown += visible;
            });

            info.textContent = query ? shown + ' / ' + total : total + ' 个组件';
        }

        input.addEventListener('input', filter);
        input.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                input.value = '';
                filter();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(event.target.tagName)) {
                event.preventDefault();
                input.focus();
                input.select();
            }
        });

        filter();
    })();
</script>
